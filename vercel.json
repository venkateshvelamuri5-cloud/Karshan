{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path(.*)",
      "destination": "/api/index?__path=:path"
    },
    {
      "source": "/b/:id",
      "destination": "/wall"
    },
    {
      "source": "/w/:id",
      "destination": "/wall"
    },
    {
      "source": "/:city(vizag|vijayawada)",
      "destination": "/clock"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
